generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique @db.VarChar(30) // ADMIN, BARBER
  users User[]
}

model User {
  id           Int      @id @default(autoincrement())
  roleId       Int
  name         String   @db.VarChar(100)
  username     String?  @unique @db.VarChar(50)
  email        String   @unique @db.VarChar(150)
  passwordHash String   @db.VarChar(255)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  role         Role     @relation(fields: [roleId], references: [id])
  barber       Barber?
}

model Barber {
  id                 Int                 @id @default(autoincrement())
  userId             Int                 @unique
  displayName        String
  commissionRate     Int                 @default(100) // Porcentaje que cobra por corte (ej: 100 dueño, 50 empleado)
  active             Boolean             @default(true)
  user               User                @relation(fields: [userId], references: [id])
  schedules          BarberSchedule[]
  scheduleExceptions ScheduleException[]
  appointments       Appointment[]
  sales              Sale[]
}

model Customer {
  id        Int      @id @default(autoincrement())
  firstName String   @db.VarChar(100)
  lastName  String   @db.VarChar(100)
  whatsapp  String   @unique @db.VarChar(30)
  email     String?  @db.VarChar(150)
  notes     String?  @db.Text
  createdAt DateTime @default(now())

  appointments Appointment[]
  sales        Sale[]
}

model Service {
  id              Int      @id @default(autoincrement())
  name            String   @db.VarChar(100)
  description     String?  @db.Text
  price           Decimal  @db.Decimal(10, 2)
  durationMinutes Int
  active          Boolean  @default(true)

  appointments Appointment[]
  saleItems    SaleItem[]
}

model BarberSchedule {
  id        Int     @id @default(autoincrement())
  barberId  Int
  weekday   Int     @db.TinyInt
  startTime String  @db.VarChar(5)
  endTime   String  @db.VarChar(5)
  active    Boolean @default(true)

  barber Barber @relation(fields: [barberId], references: [id])

  @@index([barberId, weekday])
}

model ScheduleException {
  id          Int      @id @default(autoincrement())
  barberId    Int
  date        DateTime @db.Date
  startTime   String?  @db.VarChar(5)
  endTime     String?  @db.VarChar(5)
  isAvailable Boolean
  reason      String?  @db.VarChar(255)

  barber Barber @relation(fields: [barberId], references: [id])
}

model Appointment {
  id               Int      @id @default(autoincrement())
  customerId       Int
  barberId         Int
  serviceId        Int
  appointmentDate  DateTime @db.Date
  startTime        String   @db.VarChar(5)
  endTime          String   @db.VarChar(5)
  priceSnapshot    Decimal  @db.Decimal(10, 2)
  durationSnapshot Int
  status           String   @default("PENDING") @db.VarChar(20)
  cancellationCode String   @unique @db.VarChar(100)
  notes            String?  @db.Text
  createdAt        DateTime @default(now())

  customer      Customer       @relation(fields: [customerId], references: [id])
  barber        Barber         @relation(fields: [barberId], references: [id])
  service       Service        @relation(fields: [serviceId], references: [id])
  sales         Sale[]
  notifications Notification[]
}

model ProductCategory {
  id       Int       @id @default(autoincrement())
  name     String    @db.VarChar(100)
  products Product[]
}

model Product {
  id             Int     @id @default(autoincrement())
  categoryId     Int
  name           String  @db.VarChar(100)
  price          Decimal @db.Decimal(10, 2)
  costPrice      Decimal @db.Decimal(10, 2)
  stock          Int     @default(0)
  minStock       Int     @default(5)
  itemGroup      String  @default("BEVERAGE") @db.VarChar(20)
  commissionRate Float   @default(0)
  active         Boolean @default(true)

  category       ProductCategory @relation(fields: [categoryId], references: [id])
  saleItems      SaleItem[]
  stockMovements StockMovement[]
}

model StockMovement {
  id        Int      @id @default(autoincrement())
  productId Int
  type      String   @db.VarChar(20)
  quantity  Int
  reason    String?  @db.VarChar(255)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
}

model Sale {
  id            Int      @id @default(autoincrement())
  customerId    Int?
  barberId      Int
  appointmentId Int?
  total         Decimal  @db.Decimal(10, 2)
  status        String   @default("COMPLETED") @db.VarChar(20)
  settled       Boolean  @default(false)
  settlementId  Int?
  createdAt     DateTime @default(now())

  customer    Customer?    @relation(fields: [customerId], references: [id])
  barber      Barber       @relation(fields: [barberId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  items       SaleItem[]
  payments    Payment[]
}

model SaleItem {
  id               Int     @id @default(autoincrement())
  saleId           Int
  itemType         String  @db.VarChar(20)
  serviceId        Int?
  productId        Int?
  description      String  @db.VarChar(150)
  quantity         Int
  unitPrice        Decimal @db.Decimal(10, 2)
  subtotal         Decimal @db.Decimal(10, 2)
  commissionAmount Float   @default(0)
  settled          Boolean @default(false)
  settlementId     Int?

  sale    Sale     @relation(fields: [saleId], references: [id])
  service Service? @relation(fields: [serviceId], references: [id])
  product Product? @relation(fields: [productId], references: [id])
}

model Payment {
  id        Int      @id @default(autoincrement())
  saleId    Int
  method    String   @db.VarChar(30)
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  sale Sale @relation(fields: [saleId], references: [id])
}

model Notification {
  id            Int       @id @default(autoincrement())
  appointmentId Int
  channel       String    @db.VarChar(20)
  recipient     String    @db.VarChar(150)
  message       String    @db.Text
  status        String    @default("PENDING") @db.VarChar(20)
  attempts      Int       @default(0)
  sentAt        DateTime?
  createdAt     DateTime  @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id])
}

model CashMovement {
  id            Int      @id @default(autoincrement())
  type          String   @db.VarChar(20)
  category      String   @db.VarChar(100)
  description   String?  @db.VarChar(255)
  amount        Float
  paymentMethod String   @db.VarChar(20)
  barberId      Int?
  registeredBy  String?  @db.VarChar(100)
  settled       Boolean  @default(false)
  settlementId  Int?
  createdAt     DateTime @default(now())
}

model Settlement {
  id                 Int      @id @default(autoincrement())
  barberId           Int
  dateFrom           String?  @db.VarChar(10)
  dateTo             String?  @db.VarChar(10)
  servicesCount      Int
  grossAmount        Float
  commissionAmount   Float
  advancesDeducted   Float
  netPaid            Float
  createdAt          DateTime @default(now())
}

model SecurityPin {
  id        Int     @id @default(autoincrement())
  actionKey String  @unique @db.VarChar(50)
  label     String  @db.VarChar(100)
  pin       String? @db.VarChar(4)
}